APP_NAME="People Pulse"
APP_ENV=
APP_KEY=
APP_DEBUG=false
APP_URL="https://people-pulse.app"

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=
DB_USERNAME=
DB_PASSWORD=""

SESSION_DRIVER=database
SESSION_CONNECTION=mysql
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=.people-pulse.app


BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database
MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=""
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=
MAIL_PORT=
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noreply@bdfunnelbuilder.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false
AWS_ENDPOINT=

VITE_APP_NAME="${APP_NAME}"

# Shonamoni subdomain database
SHONAMONI_DB_HOST=127.0.0.1
SHONAMONI_DB_PORT=3306
SHONAMONI_DB_DATABASE=
SHONAMONI_DB_USERNAME=
SHONAMONI_DB_PASSWORD=
# Web Push (browser/OS notifications). Generate with: php artisan webpush:vapid
VAPID_SUBJECT="mailto:admin@peoplepulse.app"
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
